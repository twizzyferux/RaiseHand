<RegisterTeacherScreen>:
    first_name: first_name
    last_name: last_name
    password: password
    password_repeat: password_repeat

    FormScroll:
        Box:
            size_hint_y: None
            height: self.minimum_height

            TitleLabel:
                text: 'Регистрация учителя'

            MutedLabel:
                text: 'Ник учителя можно добавить позже в настройках'

            Field:
                id: first_name
                hint_text: 'Имя'
                # цифры в имени не пропускаем
                on_text: root.format_name('first', self.text)

            Field:
                id: last_name
                hint_text: 'Фамилия'
                # цифры в фамилии не пропускаем
                on_text: root.format_name('last', self.text)

            # Те же «таблетки», что и в шаге регистрации ученика:
            # скруглённая серая подложка, точки и глаз. Отдельное
            # правило PasswordField тут не сработало — взяты уже
            # проверенные поля.
            PillPasswordField:
                id: password
                size_hint_x: 1
                height: dp(44)
                font_size: dp(17)
                hint_text: 'Пароль'
                password: True

            PillPasswordField:
                id: password_repeat
                size_hint_x: 1
                height: dp(44)
                font_size: dp(17)
                hint_text: 'Повторите пароль'
                password: True

            Btn:
                text: 'Далее'
                on_release: root.do_register()

            LinkButton:
                text: 'Назад'
                on_release: app.go('welcome')
