# Регистрация учителя — тот же visual language, что у ученика:
# pill-поля, глаз в пароле, FormButton.

<RegisterTeacherScreen>:
    first_name: first_name
    last_name: last_name
    password: password
    password_repeat: password_repeat

    FormScroll:
        Box:
            size_hint_y: None
            height: self.minimum_height

            TitleLabel:
                text: 'Регистрация учителя'

            MutedLabel:
                text: 'Ник учителя можно добавить позже в настройках'

            Field:
                id: first_name
                hint_text: 'Имя'
                on_text: root.format_name('first', self.text)

            Field:
                id: last_name
                hint_text: 'Фамилия'
                on_text: root.format_name('last', self.text)

            PasswordField:
                id: password
                hint_text: 'Пароль'
                password: True

            PasswordField:
                id: password_repeat
                hint_text: 'Повторите пароль'
                password: True

            FormButton:
                text: 'Далее'
                on_release: root.do_register()

            LinkButton:
                text: 'Назад'
                on_release: app.go('welcome')
