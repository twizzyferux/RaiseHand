# === ЭКРАН ЧАТОВ ==========================================================
# Макет: проект/проект экран/основной экран чаты.
# Источник истины — полный экран Face ID.svg, холст 408x874 (сцена
# приложения 450x920), поэтому каждая координата переведена:
#     x_сцены = x_макета * 450/408      y_сцены = (874 - y_макета) * 920/874
# Отдельные вырезки из того же макета идут с обрезкой (404 по ширине и
# подрезанным верхом) — по ним координаты расходились, и экран съезжал.
# В комментариях указаны координаты макета.
#
# ВАЖНО про координаты: в этой версии Kivy содержимое виджета не
# смещается вместе с родителем, поэтому у контейнеров pos = (0, 0) —
# тогда координаты детей совпадают с координатами сцены, а ряды чатов
# (ui/chats.py) рисуются целиком в своём canvas.
#
# Ряд чата, кнопка «+» и пункты нижней панели описаны в ui/chats.py:
# там же собраны все координаты макета.

# --- Пустые строки ---------------------------------------------------------

# Список пуст: подсказка, что делать дальше.
<ChatEmpty@Label>:
    size_hint: None, None
    size: dp(402), dp(88)
    pos: dp(24), dp(600)
    text: ''
    font_size: dp(17)
    color: 0.4, 0.4, 0.4, 1
    halign: 'center'
    valign: 'middle'

# Класс во вкладке «Группы»: название, школа и код для входа.
<ClassRow@Label>:
    size_hint_y: None
    height: dp(64)
    text: ''
    font_size: dp(17)
    halign: 'left'
    valign: 'middle'
    text_size: self.width - dp(10), None


# Кнопка «+» и плашка нижней панели — со стеклом на плагине
# kivy-garden.frostedglass (ui/glass_widget.py). Классы нужны, а не .kv:
# плагин нельзя собирать в разметке (размер задаётся после создания),
# и он умеет размывать то, что позади.


# --- ЭКРАН ------------------------------------------------------------------
<HomeScreen>:
    search_field: search_field
    chats_box: chats_box
    group_box: group_box
    class_code: class_code

    PhoneStage:
        id: stage
        # Шапка. В макете заголовок «Чаты» занимает x 25..193 по горизонтали,
        # буквы y 89..137 -> в сцене базовая линия y 783. Кнопка «+»:
        # круг r 29.5 в (357.5, 114.5) -> в сцене 59 x 58 в (366, 775).
        Label:
            id: tab_title
            size_hint: None, None
            # В макете буквы «Чаты» занимают x 25..193, y 783..831
            # (снизу вверх). Отсюда: левый край 25, низ текста 783 —
            # строке отдаём высоту с запасом на выносные элементы.
            pos: dp(25), dp(767)
            size: dp(340), dp(70)
            text: 'Чаты'
            font_size: dp(64)          # макет: ширина «Чаты» 169
            bold: True
            color: 0, 0, 0, 1
            # text_size обязателен: без него halign и valign в Kivy не
            # работают — заголовок центрировался вместо левого края.
            text_size: self.size
            halign: 'left'
            valign: 'bottom'

        # --- вкладка «Чаты» ---
        # Закреплённые идут первыми (их подложка — в самом ряду),
        # остальные ниже — так же, как в макете и в Телеграме.
        # ChatList, а не ScrollView: обычный перехватывает касание для
        # прокрутки, и до рядов оно не доходит — чат не открывался.
        ChatList:
            id: chats_scroll
            size_hint: None, None
            pos: dp(0), dp(97)
            width: dp(450)
            # Высота подобрана по макету: верх списка должен совпасть с
            # верхней границей ячейки первого ряда. Низ ряда 1 в макете
            # 652.1, ячейка 88.4, значит верх 740.5. Список стоит на dp(97),
            # отсюда height = 740.5 - 97 = 643.5.
            # ScrollView поднимает содержимое к верху при scroll_y = 1,
            # поэтому фактически важна именно верхняя граница списка.
            height: dp(643.5)
            do_scroll_x: False
            bar_width: dp(3)
            bar_color: 0.294, 0.184, 0.878, 0.25
            bar_inactive_color: 0.294, 0.184, 0.878, 0.08

            Widget:
                id: chats_box
                size_hint: None, None
                pos: dp(0), dp(0)
                width: dp(450)
                height: dp(88)

        # --- вкладка «Поиск» ---
        # ChatPane, а не просто Widget: скрытая панель во весь экран
        # иначе перехватывает касания у строк чатов и кнопки «+».
        ChatPane:
            id: search_pane
            size_hint: None, None
            pos: dp(0), dp(0)
            size: dp(450), dp(920)
            opacity: 0
            disabled: True

            Label:
                size_hint: None, None
                pos: dp(24), dp(700)
                size: dp(402), dp(40)
                text: 'Найдите человека по его ID'
                font_size: dp(19)
                color: 0.4, 0.4, 0.4, 1
                halign: 'left'
                valign: 'middle'

            Field:
                id: search_field
                pos: dp(24), dp(640)
                size: dp(402), dp(48)

            Btn:
                pos: dp(24), dp(572)
                size: dp(402), dp(52)
                text: 'Найти'
                on_release: root.do_search()

            Label:
                id: search_hint
                size_hint: None, None
                pos: dp(24), dp(470)
                size: dp(402), dp(80)
                text: ''
                font_size: dp(16)
                color: 0.4, 0.4, 0.4, 1
                halign: 'left'
                valign: 'top'

        # --- вкладка «Группы» ---
        ChatPane:
            id: groups_pane
            size_hint: None, None
            pos: dp(0), dp(0)
            size: dp(450), dp(920)
            opacity: 0
            disabled: True

            Label:
                size_hint: None, None
                pos: dp(24), dp(700)
                size: dp(402), dp(40)
                text: 'Введите код класса, который дал учитель'
                font_size: dp(19)
                color: 0.4, 0.4, 0.4, 1
                halign: 'left'
                valign: 'middle'

            Field:
                id: class_code
                pos: dp(24), dp(640)
                size: dp(402), dp(48)
                on_text: root.format_class_code(self.text)

            Btn:
                pos: dp(24), dp(572)
                size: dp(402), dp(52)
                text: 'Присоединиться'
                on_release: root.join_class()

            ScrollView:
                id: groups_scroll
                size_hint: None, None
                pos: dp(24), dp(120)
                width: dp(402)
                height: dp(440)
                do_scroll_x: False
                bar_width: dp(3)
                bar_color: 0.294, 0.184, 0.878, 0.25

                BoxLayout:
                    id: group_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)

        # --- нижняя панель ---
        # Плашка — стекло на плагине (ui/glass_widget.py): размеры из
        # макета, 360x60 в (24, 780) -> в сцене 397.1 x 63.2 в (26.5, 35.8).
        GlassPanel:
            id: navbar

        # Кнопка «+» объявлена ПОСЛЕ панелей вкладок: иначе они лежат
        # поверх неё и съедают касание (в Kivy маршрутизация идёт по
        # порядку добавления, сверху вниз, и останавливается на первом
        # виджете, который взял касание).
        GlassFab:
            id: fab
            on_release: root.new_chat()

        # Пункты панели — прямые потомки сцены (координаты абсолютные).
        # Иконки и подписи рисует сам NavItem по координатам макета
        # (ui/chats.py), а pos/size задают только зону нажатия: пункты
        # стоят друг на друге, поэтому каждая четверть плашки должна
        # иметь свою границу, иначе верхний пункт («Настройки»)
        # перехватывал бы нажатия по всей панели, и «Поиск» открывал бы
        # настройки.
        # Обработчик on_release нужен КАЖДОМУ пункту: без него пункт
        # просто молча не нажимается. Три вкладки переключают панели
        # экрана, четвёртая («Настройки») уходит на отдельный экран.
        NavItem:
            id: nav_search
            pos: dp(26.5), dp(35.8)
            on_release: root.switch_tab('search')

        NavItem:
            id: nav_chats
            pos: dp(125.8), dp(35.8)
            on_release: root.switch_tab('chats')

        NavItem:
            id: nav_groups
            pos: dp(225.1), dp(35.8)
            on_release: root.switch_tab('groups')

        NavItem:
            id: nav_settings
            pos: dp(324.4), dp(35.8)
            on_release: app.go('settings')