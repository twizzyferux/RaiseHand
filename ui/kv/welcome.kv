# Стартовый экран по макету проект/регистрация.svg (фрейм 1).
# Холст 450x920; y_киви = 920 - y_макет - высота.

# --- декор: цветные «пузыри» внизу экрана ---------------------------------
# Рисуются классом WelcomeDecor (ui/decor.py): он же мягко покачивает
# их вверх-вниз. Здесь только расположение в разметке.


# Точка-индикатор карусели. Видимая точка 10dp внутри зоны касания 44dp.
# Цвет не переключается рывком, а плавно перетекает из светло-фиолетового
# в фиолетовый: active_t = 0 — неактивная, 1 — активная.
<SlideDot>:
    size_hint: None, None
    size: dp(44), dp(44)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0

    canvas.before:
        Color:
            rgba: 0.718 + (0.294 - 0.718) * self.active_t, 0.675 + (0.184 - 0.675) * self.active_t, 0.953 + (0.878 - 0.953) * self.active_t, 1
        Ellipse:
            pos: self.center_x - dp(5), self.center_y - dp(5)
            size: dp(10), dp(10)


<WelcomeScreen>:
    # белый фон окна вокруг телефона (старые экраны полагаются на чёрный
    # цвет окна, поэтому clearcolor не трогаем)
    canvas.before:
        Color:
            rgba: 1, 0.984, 0.969, 1
        Rectangle:
            pos: self.pos
            size: self.size

    PhoneStage:
        WelcomeDecor:
            id: w_decor

        # логотип + надпись RaiseHand
        #
        # Логотип стоит на одной линии с заголовком: левый край у них
        # общий, 25dp, как у текста ниже. Раньше логотип начинался на
        # 54dp, и шапка выглядела сдвинутой вправо относительно
        # заголовка.
        Image:
            size_hint: None, None
            pos: dp(25), dp(775)
            id: w_logo
            size: dp(44), dp(44)
            source: app.sprite('rh_logo')
            mipmap: True

        Image:
            size_hint: None, None
            pos: dp(75), dp(786)
            id: w_word
            size: dp(181), dp(33)
            source: app.sprite('rh_wordmark')
            mipmap: True
            fit_mode: 'contain'

        # заголовок: три фразы по очереди (см. WelcomeScreen)
        Label:
            size_hint: None, None
            pos: dp(25), dp(633)
            id: w_title
            size: dp(400), dp(100)
            text: root.slide_title
            font_size: dp(41)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            line_spacing: dp(2)
            text_size: self.width, None

        # подзаголовок
        Label:
            size_hint: None, None
            pos: dp(25), dp(542)
            id: w_sub
            size: dp(400), dp(74)
            text: root.slide_subtitle
            font_size: dp(22.5)
            color: 0.278, 0.278, 0.278, 1
            halign: 'left'
            line_spacing: dp(5)
            text_size: self.width, None

        # точки-индикаторы: активная — фиолетовая, остальные — светлые.
        # Цвет перетекает плавно (active_t), нажатие сжимает точку.
        SlideDot:
            id: dot0
            pos: dp(168), dp(479)
            on_release: root.set_slide(0)

        SlideDot:
            id: dot1
            pos: dp(198), dp(479)
            on_release: root.set_slide(1)

        SlideDot:
            id: dot2
            pos: dp(228), dp(479)
            on_release: root.set_slide(2)

        # «Присоединяйтесь как…»
        # В макете (проект/проект экран/экран 1) — именно такая строка, и
        # кегль снят из неё: чернила по высоте и по ширине сошлись.
        Label:
            size_hint: None, None
            # Блок шире строки: при кегле 25 текст не помещался в 260 и
            # переносился на вторую строку, наезжая на кнопку. Ширина
            # блока — по макетной строке целиком, центр тот же.
            pos: dp(30), dp(432)
            id: w_join
            size: dp(390), dp(30)
            text: 'Присоединяйтесь как…'
            font_size: dp(25)
            color: 0, 0, 0, 1
            halign: 'center'
            text_size: self.width, None

        # кнопки выбора роли
        PillButton:
            id: w_student
            pos: dp(45), dp(360)
            size: dp(360), dp(52.8)
            text: 'Я Ученик'
            on_release: app.start_student_registration()

        PillOutlineButton:
            id: w_teacher
            pos: dp(45), dp(287)
            size: dp(360), dp(52.8)
            text: 'Я Учитель'
            on_release: app.go('register_teacher')

        # ссылка входа
        LinkButton:
            id: w_link
            size_hint: None, None
            pos: dp(25), dp(240)
            size: dp(400), dp(34)
            font_size: dp(20)
            color: 0, 0, 0, 1
            halign: 'center'
            text_size: self.width, None
            markup: True
            text: 'Уже зарегистрированы? [b][color=4b2fe0]Войти[/b][/color]'
            on_release: app.go('login')
