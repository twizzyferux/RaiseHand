# Альтернативная одноэкранная регистрация ученика (если используется).
# Основной поток — пошаговый в register.kv (RegStep1..5).

<RegisterStudentScreen>:
    first_name: first_name
    last_name: last_name
    nickname: nickname
    password: password
    password_repeat: password_repeat

    FormScroll:
        Box:
            size_hint_y: None
            height: self.minimum_height

            TitleLabel:
                text: 'Регистрация ученика'

            MutedLabel:
                text: 'Имя и фамилия видны учителям, ник — всем в профиле'

            Field:
                id: first_name
                hint_text: 'Имя'
                on_text: root.format_name('first', self.text)

            Field:
                id: last_name
                hint_text: 'Фамилия'
                on_text: root.format_name('last', self.text)

            Field:
                id: nickname
                hint_text: 'Ник (отображается в профиле)'

            PasswordField:
                id: password
                hint_text: 'Пароль'
                password: True

            PasswordField:
                id: password_repeat
                hint_text: 'Повторите пароль'
                password: True

            FormButton:
                text: 'Далее'
                on_release: root.do_register()

            LinkButton:
                text: 'Назад'
                on_release: app.go('welcome')
