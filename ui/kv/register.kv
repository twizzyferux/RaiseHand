# Пошаговая регистрация ученика — макет проект/регистрация.svg, фреймы 2-6.
# Общая «шапка» (назад / заголовок / прогресс / согласие / «Далее»)
# вынесена в RegChrome (ui/screens.py), экраны добавляют только свои поля.

# --- ДЕКОРАТИВНЫЕ ПИЛЛИ РАЗДЕЛА «Всё готово!» ----------------------------
<DoneRows@Widget>:
    canvas:
        Color:
            rgba: 0.937, 0.937, 0.957, 1
        RoundedRectangle:
            pos: dp(49), dp(400)
            size: dp(350), dp(60)
            radius: [dp(30), ]
        RoundedRectangle:
            pos: dp(50), dp(316)
            size: dp(350), dp(60)
            radius: [dp(30), ]
        RoundedRectangle:
            pos: dp(49), dp(232)
            size: dp(350), dp(60)
            radius: [dp(30), ]


# --- ОБЩАЯ ШАПКА ШАГА ----------------------------------------------------
<RegChrome>:
    # «← Назад» (фиолетовый, слева)
    LinkButton:
        size_hint: None, None
        pos: dp(36), dp(806)
        size: dp(120), dp(36)
        font_size: dp(18)
        bold: True
        color: 0.294, 0.184, 0.878, 1
        halign: 'left'
        text_size: self.width, None
        text: '← Назад'
        opacity: 1 if root.show_back else 0
        disabled: not root.show_back
        on_release: app.go(root.back_to)

    # центральный заголовок строки
    Label:
        size_hint: None, None
        pos: dp(115), dp(804)
        size: dp(220), dp(38)
        text: root.header_title
        font_size: dp(18.5)
        bold: True
        color: 0, 0, 0, 1
        halign: 'center'
        text_size: self.width, None

    # большой заголовок шага
    Label:
        size_hint: None, None
        pos: dp(48), dp(718)
        size: dp(355), dp(92)
        text: root.title
        font_size: dp(42.5)
        bold: True
        color: 0, 0, 0, 1
        halign: 'left'
        text_size: self.width, None

    # подзаголовок (шаги 3 и 4)
    # ВАЖНО: subtitle_cy задан в единицах макета (dp), поэтому и вычитание
    # делаем внутри dp(). Если смешать сырое число с dp(40), то на плотности
    # не равной 1 подпись «уедет» и накроет поле (так и случилось).
    Label:
        size_hint: None, None
        pos: dp(57), dp(root.subtitle_cy - 40)
        size: dp(336), dp(80)
        text: root.subtitle
        font_size: dp(20)
        color: 0.4, 0.4, 0.4, 1
        halign: 'center'
        line_spacing: dp(1)
        text_size: self.width, None
        opacity: 1 if root.subtitle else 0

    # прогресс
    RegProgress:
        pos: dp(77.5), dp(704.5)
        value: root.progress
        opacity: 1 if root.show_progress else 0

    # согласие с правилами (2 строки, по левому краю)
    Label:
        size_hint: None, None
        pos: dp(65), dp(151)
        size: dp(325), dp(50)
        text: 'Нажимая далее вы соглашаетесь\nс правилами RaiseHand'
        font_size: dp(19.5)
        color: 0.62, 0.62, 0.62, 1
        halign: 'left'
        line_spacing: dp(2)
        text_size: self.width, None
        opacity: 1 if root.show_consent else 0

    # основная кнопка шага
    PillButton:
        pos: dp(64), dp(77)
        size: dp(321), dp(53)
        text: root.next_label
        on_release: root.do_next()


# --- ШАГ 1: «Как вас зовут?» --------------------------------------------
<RegStep1Screen>:
    first_name: first_name
    last_name: last_name

    canvas.before:
        Color:
            rgba: 1, 0.984, 0.969, 1
        Rectangle:
            pos: self.pos
            size: self.size

    PhoneStage:
        RegChrome:
            back_to: 'welcome'
            title: 'Как вас зовут?'
            progress: 55
            next_callback: root.next

        Label:
            size_hint: None, None
            pos: dp(95), dp(638)
            size: dp(220), dp(23)
            text: 'Имя'
            font_size: dp(21)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        PillInput:
            id: first_name
            pos: dp(75), dp(584)
            hint_text: 'Иван'
            # цифры в имени не пропускаем
            on_text: root.format_name('first', self.text)

        Label:
            size_hint: None, None
            pos: dp(90.5), dp(560)
            size: dp(220), dp(20)
            text: 'Видно всем'
            # Кегль снят из макета (экран 2): чернила по высоте и по
            # ширине сошлись — 17.9 в сцене 450x920.
            font_size: dp(18)
            color: 0.4, 0.4, 0.4, 1
            halign: 'left'
            text_size: self.width, None

        Label:
            size_hint: None, None
            pos: dp(89), dp(507)
            size: dp(220), dp(23)
            text: 'Фамилия'
            # Кегль снят из макета (экран 2): 22.0 в сцене.
            font_size: dp(22)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        PillInput:
            id: last_name
            pos: dp(75), dp(453)
            hint_text: 'Иванов'
            # цифры в фамилии не пропускаем
            on_text: root.format_name('last', self.text)

        Label:
            size_hint: None, None
            pos: dp(90.5), dp(429)
            size: dp(220), dp(20)
            text: 'Видно всем'
            # Кегль снят из макета (экран 2): чернила по высоте и по
            # ширине сошлись — 17.9 в сцене 450x920.
            font_size: dp(18)
            color: 0.4, 0.4, 0.4, 1
            halign: 'left'
            text_size: self.width, None


# --- ШАГ 2: «Введите пароль» --------------------------------------------
<RegStep2Screen>:
    password: password
    password_repeat: password_repeat
    remember: remember

    canvas.before:
        Color:
            rgba: 1, 0.984, 0.969, 1
        Rectangle:
            pos: self.pos
            size: self.size

    PhoneStage:
        RegChrome:
            back_to: 'reg_step1'
            title: 'Введите пароль'
            progress: 115
            next_callback: root.next

        Label:
            size_hint: None, None
            pos: dp(95), dp(639)
            size: dp(220), dp(23)
            text: 'Пароль'
            font_size: dp(21)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        PillPasswordField:
            id: password
            pos: dp(75), dp(585)
            hint_text: '••••••••'
            font_size: dp(33.5)
            password: True

        Label:
            size_hint: None, None
            pos: dp(95.5), dp(568)
            size: dp(260), dp(20)
            text: 'Минимум 6 символов'
            font_size: dp(16.5)
            color: 0.4, 0.4, 0.4, 1
            halign: 'left'
            text_size: self.width, None

        Label:
            size_hint: None, None
            pos: dp(90), dp(510)
            size: dp(300), dp(23)
            text: 'Подтверждение пароль'
            font_size: dp(21)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        PillPasswordField:
            id: password_repeat
            pos: dp(75), dp(454)
            hint_text: '••••••••'
            font_size: dp(33.5)
            password: True

        CheckToggle:
            id: remember
            pos: dp(91), dp(404)
            state: 'down'

        Label:
            size_hint: None, None
            pos: dp(128.8), dp(407)
            size: dp(260), dp(23)
            text: 'Запомнить меня'
            font_size: dp(22.5)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None


# Страна в подсказке номера: нажал — код подставился в поле.
<CountryChip@Btn>:
    size_hint_y: None
    height: dp(30)
    font_size: dp(17)
    color: 0.1, 0.1, 0.12, 1
    halign: 'left'
    text_size: self.width - dp(20), None
    canvas.before:
        Color:
            rgba: 0.945, 0.941, 1, 1 if self.state == 'down' else 0
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12), ]


# Строка подсказки города: нажал — город подставился в поле.
<CityRow@Btn>:
    size_hint_y: None
    height: dp(40)
    font_size: dp(18)
    color: 0.1, 0.1, 0.12, 1
    halign: 'left'
    text_size: self.width - dp(28), None
    canvas.before:
        Color:
            rgba: 0.945, 0.941, 1, 1 if self.state == 'down' else 0
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12), ]


# --- ШАГ 3: «Где вы учитесь?» -------------------------------------------
<RegStep3Screen>:
    invite_code: invite_code

    canvas.before:
        Color:
            rgba: 1, 0.984, 0.969, 1
        Rectangle:
            pos: self.pos
            size: self.size

    PhoneStage:
        RegChrome:
            back_to: 'reg_step2'
            title: 'Где вы учитесь?'
            subtitle: 'Введите город и код от учителя,\nчтобы присоединиться к классу'
            subtitle_cy: 668
            progress: 175
            next_callback: root.next

        Label:
            size_hint: None, None
            pos: dp(97.9), dp(569)
            size: dp(220), dp(23)
            text: 'Город'
            font_size: dp(21)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        PillInput:
            id: city
            pos: dp(76), dp(518)
            hint_text: 'Москва'
            font_size: dp(20)
            # Подсказки городов появляются, пока печатаешь
            on_text: root.on_city_typed(self.text)
            on_text_validate: root.pick_city(root.city_suggestions[0])

        Label:
            size_hint: None, None
            pos: dp(97.4), dp(499)
            size: dp(220), dp(20)
            text: 'Мин. 2 символа'
            font_size: dp(16.5)
            color: 0.4, 0.4, 0.4, 1
            halign: 'left'
            text_size: self.width, None

        Label:
            size_hint: None, None
            pos: dp(99), dp(445)
            size: dp(260), dp(23)
            text: 'Код приглашения'
            font_size: dp(22.5)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        PillInput:
            id: invite_code
            pos: dp(74), dp(390)
            hint_text: 'A12-3B4'
            # Регистр не трогаем — набирают как удобно, но тире между
            # 3-м и 4-м символом подставляется само.
            on_text: root.format_invite(self.text)

        Label:
            size_hint: None, None
            pos: dp(96.2), dp(353)
            size: dp(260), dp(36)
            text: 'Код можно узнать от учителя\nили в чате класса'
            font_size: dp(16.5)
            color: 0.4, 0.4, 0.4, 1
            halign: 'left'
            line_spacing: dp(1)
            text_size: self.width, None

        # Подсказки городов: появляются под полем, пока печатаешь,
        # и исчезают, когда город выбран. Список строк собирает
        # RegStep3Screen.on_city_typed (см. ui/screens.py).
        BoxLayout:
            id: city_box
            orientation: 'vertical'
            size_hint: None, None
            # верх списка прижат к низу поля города: список появляется
            # ровно под ним, какой бы высоты ни оказался
            pos: dp(76), city.y - self.height
            width: dp(300)
            # высота по содержимому, но не больше пяти строк
            height: min(self.minimum_height, dp(228))
            spacing: dp(2)
            padding: dp(6)
            opacity: 0 if not root.city_suggestions else 1
            disabled: not root.city_suggestions
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(18), ]
                Color:
                    rgba: 0.87, 0.87, 0.91, 1
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(18))
                    width: dp(1)


# --- ШАГ 4: «Подтверждение» ---------------------------------------------
<RegStep4Screen>:
    contact: contact
    code_field: code_field

    canvas.before:
        Color:
            rgba: 1, 0.984, 0.969, 1
        Rectangle:
            pos: self.pos
            size: self.size

    PhoneStage:
        RegChrome:
            back_to: 'reg_step3'
            header_title: 'Последний этап!'
            title: 'Подтверждение'
            subtitle: 'Впишите свой адрес электронной\nпочты, либо номер телефона,\nчтобы подтвердить свой аккаунт'
            subtitle_cy: 654.5
            progress: 235
            next_callback: root.next

        Label:
            id: contact_label
            size_hint: None, None
            pos: dp(92.7), dp(572)
            size: dp(260), dp(23)
            text: 'E-mail/Телефон'
            # когда открыт выбор страны, подпись не нужна
            opacity: 0 if root.show_countries else 1
            font_size: dp(21)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        PillInput:
            id: contact
            pos: dp(73), dp(518)
            hint_text: 'ivan@example.com'
            # Ничего не форматируем: в почте регистр важен, а тире
            # внутри адреса его ломает
            on_text: root.on_contact_typed(self.text)

        PillButton:
            pos: dp(117), dp(460)
            size: dp(211), dp(50)
            text: 'Получить код'
            on_release: root.send_code()

        Label:
            size_hint: None, None
            pos: dp(97), dp(415)
            size: dp(250), dp(40)
            text: 'Код придет вам на почту либо\nна ваш номер телефона'
            font_size: dp(16.5)
            color: 0.4, 0.4, 0.4, 1
            halign: 'center'
            line_spacing: dp(1)
            text_size: self.width, None

        Label:
            size_hint: None, None
            pos: dp(99.1), dp(371)
            size: dp(280), dp(23)
            text: 'Код подтверждения'
            font_size: dp(23.5)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        PillInput:
            id: code_field
            pos: dp(75), dp(315)
            hint_text: '123ABC'
            # Код подтверждения: заглавные буквы, без разделителей
            on_text: root.format_code(self.text)


        # Выбор страны: появляется над полем, когда начали набирать
        # номер. Пока список открыт, подпись «E-mail/Телефон» скрыта.
        BoxLayout:
            id: country_box
            orientation: 'vertical'
            size_hint: None, None
            # низ списка — верх поля, список растёт вверх
            pos: dp(73), contact.top
            width: dp(304)
            # не выше полоски прогресса (она на dp(704.5))
            height: min(self.minimum_height, dp(136))
            spacing: dp(2)
            padding: dp(6)
            opacity: 0 if not root.show_countries else 1
            disabled: not root.show_countries
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(18), ]
                Color:
                    rgba: 0.87, 0.87, 0.91, 1
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(18))
                    width: dp(1)


# --- ШАГ 5: «Всё готово!» ------------------------------------------------
<RegStep5Screen>:
    canvas.before:
        Color:
            rgba: 1, 0.984, 0.969, 1
        Rectangle:
            pos: self.pos
            size: self.size

    PhoneStage:
        DoneRows:

        RegChrome:
            header_title: 'Всё готово!'
            show_back: False
            show_progress: False
            show_consent: False
            next_label: 'Начать общение'
            next_callback: root.start

        # аватар: личный градиент пользователя + инициалы
        GradientAvatar:
            id: avatar
            size_hint: None, None
            pos: dp(166), dp(665)
            size: dp(120), dp(120)

        # приветствие
        Label:
            size_hint: None, None
            pos: dp(41), dp(551)
            size: dp(360), dp(88)
            text: root.welcome_text
            font_size: dp(34)
            bold: True
            color: 0, 0, 0, 1
            halign: 'center'
            line_height: 1.15
            text_size: self.width, None

        # строки: Класс / Школа / Роль
        Label:
            size_hint: None, None
            pos: dp(104.7), dp(421)
            size: dp(140), dp(23)
            text: 'Класс'
            font_size: dp(28)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        Label:
            size_hint: None, None
            pos: dp(207), dp(421)
            size: dp(200), dp(23)
            text: root.class_value
            font_size: dp(28)
            bold: True
            color: 0, 0, 0, 1
            halign: 'center'
            text_size: self.width, None

        Label:
            size_hint: None, None
            pos: dp(104.6), dp(338)
            size: dp(140), dp(23)
            text: 'Школа'
            font_size: dp(28)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        Label:
            size_hint: None, None
            pos: dp(207), dp(338)
            size: dp(200), dp(21)
            text: root.school_value
            font_size: dp(19.5)
            color: 0, 0, 0, 1
            halign: 'center'
            text_size: self.width, None

        Label:
            size_hint: None, None
            pos: dp(104.6), dp(254)
            size: dp(140), dp(23)
            text: 'Роль'
            font_size: dp(28)
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            text_size: self.width, None

        Label:
            size_hint: None, None
            pos: dp(207), dp(254)
            size: dp(200), dp(23)
            text: 'Ученик'
            font_size: dp(28)
            bold: True
            color: 0, 0, 0, 1
            halign: 'center'
            text_size: self.width, None
