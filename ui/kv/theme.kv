# === ОБЩИЕ ПРАВИЛА ===

# Весь текст приложения — фирменным шрифтом (по умолчанию SF Pro Text).
# Имя приходит из config/settings.json -> "font" -> "name".
# Правило на базовом классе значит, что шрифт не нужно указывать
# в каждом экране по отдельности — сменил настройку, сменился везде.
<Label>:
    font_name: app.font_name
    # Цвет текста по умолчанию. В Kivy он белый — и на старом чёрном фоне
    # это не было заметно. Фон везде кремовый (макет: проект/*.svg), поэтому
    # без тёмного цвета текст с ним сливался и «становился невидимым».
    # Чёрный — как в заголовках register.kv, снятых с того же макета.
    color: 0, 0, 0, 1

<TextInput>:
    font_name: app.font_name

# Поле формы (полная ширина в FormScroll). Стиль как у PillInput:
# таблетка #EFEFF4, без серой системной рамки Kivy.
<Field@TextInput>:
    size_hint_y: None
    height: dp(50)
    multiline: False
    write_tab: False
    padding: [dp(18), (self.height - self.line_height) / 2]
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: 0.08, 0.08, 0.1, 1
    hint_text_color: 0.557, 0.557, 0.576, 1
    cursor_color: 0.294, 0.184, 0.878, 1
    font_size: dp(17)

    canvas.before:
        Color:
            rgba: 0.937, 0.937, 0.957, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2, ]
        Color:
            rgba:
                (self.cursor_color
                if self.focus and not self._cursor_blink
                and int(self.x + self.padding[0]) <= self._cursor_visual_pos[0] <= int(self.x + self.width - self.padding[2])
                else (0, 0, 0, 0))
        Rectangle:
            pos: self._cursor_visual_pos
            size: self.cursor_width, -self._cursor_visual_height
        Color:
            rgba: self.disabled_foreground_color if self.disabled else (self.hint_text_color if not self.text else self.foreground_color)

# Поля пароля с глазом.
#
# ПОЧЕМУ ИХ ДВА И ПОЧЕМУ КАЖДОЕ САМО ПО СЕБЕ
# ------------------------------------------------
# Правила в .kv НЕ наследуются по имени: описал стиль для PillInput —
# на PasswordField он не перейдёт. Из-за этого стоило добавить глаз, как
# подкладывали «таблетку», и она пропадала: новое правило её не знало.
# Значит, каждое правило должно содержать СРАЗУ и подложку, и глаз.
# Тогда глаз ничего не стоит по виду.
#
# Слои внутри поля: подложка (canvas.before) -> текст (собственная
# отрисовка поля) -> глаз (canvas.after).

# --- поле пароля формы + глаз (полная ширина, стиль таблетки) -------------

<PasswordField>:
    size_hint_y: None
    height: dp(50)
    multiline: False
    write_tab: False
    password: True
    # Справа отступ под иконку, чтобы текст под неё не лез.
    padding: [dp(18), (self.height - self.line_height) / 2, dp(44), (self.height - self.line_height) / 2]
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: 0.08, 0.08, 0.1, 1
    hint_text_color: 0.557, 0.557, 0.576, 1
    cursor_color: 0.294, 0.184, 0.878, 1
    font_size: dp(17)

    canvas.before:
        Color:
            rgba: 0.937, 0.937, 0.957, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2, ]
        Color:
            rgba:
                (self.cursor_color
                if self.focus and not self._cursor_blink
                and int(self.x + self.padding[0]) <= self._cursor_visual_pos[0] <= int(self.x + self.width - self.padding[2])
                else (0, 0, 0, 0))
        Rectangle:
            pos: self._cursor_visual_pos
            size: self.cursor_width, -self._cursor_visual_height
        Color:
            rgba: self.disabled_foreground_color if self.disabled else (self.hint_text_color if not self.text else self.foreground_color)

    canvas.after:
        Color:
            rgba: 0.45, 0.45, 0.5, 0 if self.show_password else 1
        Rectangle:
            pos: self.right - dp(36), self.center_y - dp(11)
            size: dp(22), dp(22)
            source: app.sprite('rh_eye')
        Color:
            rgba: 0.45, 0.45, 0.5, 1 if self.show_password else 0
        Rectangle:
            pos: self.right - dp(36), self.center_y - dp(11)
            size: dp(22), dp(22)
            source: app.sprite('rh_eye_off')

# --- «таблетка» с паролем + глаз -------------------------------------------
# Повторяет PillInput целиком (ниже) — иначе скруглённая подложка
# пропала бы, стоит добавить глаз. Отличие одно: справа отступ под иконку.

<PillPasswordField>:
    size_hint: None, None
    size: dp(300), dp(50)
    multiline: False
    write_tab: False
    password: True
    padding: [dp(22), (self.height - self.line_height) / 2, dp(44), (self.height - self.line_height) / 2]
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: 0.08, 0.08, 0.1, 1
    hint_text_color: 0.557, 0.557, 0.576, 1
    cursor_color: 0.294, 0.184, 0.878, 1
    font_size: dp(33.5)

    # ВНИМАНИЕ: style.kv держит Color текста и курсора тоже в
    # canvas.before, а наши инструкции добавляются ПОСЛЕ них — color
    # state на входе в главный canvas становится цветом таблетки, и
    # хинт с курсором рисуются цветом фона. Поэтому после таблетки
    # продублированы Color курсора и Color текста (как в PillInput).
    canvas.before:
        Color:
            rgba: 0.937, 0.937, 0.957, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2, ]
        Color:
            rgba:
                (self.cursor_color
                if self.focus and not self._cursor_blink
                and int(self.x + self.padding[0]) <= self._cursor_visual_pos[0] <= int(self.x + self.width - self.padding[2])
                else (0, 0, 0, 0))
        Rectangle:
            pos: self._cursor_visual_pos
            size: self.cursor_width, -self._cursor_visual_height
        Color:
            rgba: self.disabled_foreground_color if self.disabled else (self.hint_text_color if not self.text else self.foreground_color)

    canvas.after:
        Color:
            rgba: 0.45, 0.45, 0.5, 0 if self.show_password else 1
        Rectangle:
            pos: self.right - dp(38), self.center_y - dp(11)
            size: dp(22), dp(22)
            source: app.sprite('rh_eye')
        Color:
            rgba: 0.45, 0.45, 0.5, 1 if self.show_password else 0
        Rectangle:
            pos: self.right - dp(38), self.center_y - dp(11)
            size: dp(22), dp(22)
            source: app.sprite('rh_eye_off')


<Btn@PressButton>:
    size_hint_y: None
    height: dp(48)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    # Подложки нет (фона 0,0,0,0), поэтому текст должен быть тёмным —
    # иначе на кремовом фоне он не читается. Свои цвета у кнопок с
    # заливкой (ChoiceButton, PillButton, FormButton) заданы отдельно.
    color: 0, 0, 0, 1

# Основная кнопка форм (Settings / Verify / Login / Teacher):
# фиолетовая таблетка на всю ширину, белый текст — как PillButton.
<FormButton@Btn>:
    size_hint_y: None
    height: dp(52)
    color: 1, 1, 1, 1
    font_size: dp(17)
    bold: True
    halign: 'center'
    text_size: self.width - dp(16), None

    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.04
        RoundedRectangle:
            pos: self.x, self.y - dp(2)
            size: self.size
            radius: [self.height / 2, ]
        Color:
            rgba: 0.294 - 0.074 * self.press_tint, 0.184 - 0.064 * self.press_tint, 0.878 - 0.158 * self.press_tint, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2, ]

# Вторичная кнопка форм: белая с фиолетовой обводкой.
<FormOutlineButton@Btn>:
    size_hint_y: None
    height: dp(52)
    color: 0, 0, 0, 1
    font_size: dp(17)
    bold: True
    halign: 'center'
    text_size: self.width - dp(16), None

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2, ]
        Color:
            rgba: 0.294, 0.184, 0.878, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.height / 2)
            width: dp(2.5)

# === PRIMARY КНОПКА (синяя с тенью) ===
# Если задан спрайт (config/settings.json -> sprites.choice_primary),
# он используется как фон; иначе рисуется векторный вариант ниже.

<ChoiceButton@Btn>:
    size_hint: None, None
    size: dp(280), dp(56)

    color: 1, 1, 1, 1
    font_size: dp(16)
    bold: True
    halign: 'center'
    text_size: self.width, None

    # --- фон-спрайт ---
    background_normal: app.sprite('choice_primary')
    background_down: app.sprite('choice_primary_down') or app.sprite('choice_primary')
    background_color: (1, 1, 1, 1) if app.sprite('choice_primary') else (0, 0, 0, 0)
    # Без 9-slice: спрайт растягивается целиком, поэтому PNG
    # должен иметь те же пропорции, что и кнопка (280:56 = 5:1)
    border: 0, 0, 0, 0

    canvas.before:
        # Тень
        Color:
            rgba: (0, 0, 0, 0) if app.sprite('choice_primary') else (0.18, 0.42, 1, 0.18)
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.width, self.height
            radius: [dp(28), ]
        # Заливка
        Color:
            rgba: (0, 0, 0, 0) if app.sprite('choice_primary') else ((0.18, 0.42, 1, 1) if self.state == 'normal' else (0.14, 0.34, 0.85, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(28), ]

# === SECONDARY КНОПКА (обводка) ===
# Спрайт: sprites.choice_secondary / choice_secondary_down

<ChoiceButtonSecondary@Btn>:
    size_hint: None, None
    size: dp(280), dp(56)

    color: 0, 0, 0, 1
    font_size: dp(16)
    bold: True
    halign: 'center'
    text_size: self.width, None

    # --- фон-спрайт ---
    background_normal: app.sprite('choice_secondary')
    background_down: app.sprite('choice_secondary_down') or app.sprite('choice_secondary')
    background_color: (1, 1, 1, 1) if app.sprite('choice_secondary') else (0, 0, 0, 0)
    border: 0, 0, 0, 0

    canvas.before:
        Color:
            rgba: (0, 0, 0, 0) if app.sprite('choice_secondary') else ((1, 1, 1, 1) if self.state == 'normal' else (0.96, 0.97, 1, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(28), ]
        Color:
            rgba: (0, 0, 0, 0) if app.sprite('choice_secondary') else (0.18, 0.42, 1, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(28))
            width: dp(1.5)

# === LINK (текстовая кнопка) ===

<LinkButton@Btn>:
    height: dp(44)
    font_size: dp(15)
    color: 0.294, 0.184, 0.878, 1
    bold: True

# === ЛЕЙБЛЫ ===

<TitleLabel@Label>:
    size_hint_y: None
    text_size: self.width, None
    height: self.texture_size[1] + dp(8)
    halign: 'center'
    bold: True
    font_size: dp(28)
    color: 0, 0, 0, 1

<BodyLabel@Label>:
    size_hint_y: None
    text_size: self.width, None
    height: self.texture_size[1] + dp(4)
    halign: 'left'
    # Цвет основного текста из макета: #666666 (проект/регистрация.svg).
    color: 0.25, 0.25, 0.27, 1
    font_size: dp(15)

<MutedLabel@BodyLabel>:
    halign: 'center'
    color: 0.4, 0.4, 0.42, 1
    font_size: dp(14)

# === КОНТЕЙНЕРЫ ===

<Box@BoxLayout>:
    orientation: 'vertical'
    padding: dp(24), dp(28), dp(24), dp(24)
    spacing: dp(12)

<Card@BoxLayout>:
    orientation: 'vertical'
    padding: dp(8)
    spacing: dp(8)
    size_hint_y: None
    height: self.minimum_height

<FormScroll@ScrollView>:
    do_scroll_x: False

<ThemedSpinner@Spinner>:
    size_hint_y: None
    height: dp(50)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: 0.08, 0.08, 0.1, 1
    font_size: dp(16)
    canvas.before:
        Color:
            rgba: 0.937, 0.937, 0.957, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2, ]

# =========================================================================== #
#  НОВЫЙ ДИЗАЙН (макет: проект/регистрация.svg)
#  Холст 450x920: кремовый экран без интерфейса устройства.
# =========================================================================== #

# --- СЦЕНА ЭКРАНА ---------------------------------------------------------
# Чистый цифровой макет: ни рамки телефона, ни статус-бара, ни динамического
# острова, ни индикатора «домой» — только кремовый фон и контент.
# Сцена всегда в (0,0) размером 450x920 — все координаты ниже абсолютные,
# как в макете (y вниз переворачиваем: kivy_y = 920 - y_макет - h).

# Класс объявлен в ui/screens.py (PhoneStage) — здесь только стиль.
# Не писать <PhoneStage@FloatLayout>: иначе Factory re-declaration.
<PhoneStage>:
    size_hint: None, None
    size: dp(450), dp(920)
    # Размеры макета хранятся отдельно от size: на телефоне сцена
    # растягивается по высоте экрана (ui/screens.py -> _pin_stage), и
    # пересчёт идёт от них, а не от уже изменённого размера. Иначе
    # масштаб с каждым кадром считался бы от предыдущего и уезжал.
    design_w: 450
    design_h: 920
    # На телефоне и планшете экран может быть шире макета — держим сцену
    # по центру, чтобы не прилипала к краю.
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    canvas.before:
        # кремовый экран #FFFBF7 на всё окно
        Color:
            rgba: 1, 0.984, 0.969, 1
        Rectangle:
            pos: self.pos
            size: self.size


# --- PRIMARY КНОПКА (фиолетовая, со ступенчатой тенью) --------------------

<PillButton@Btn>:
    size_hint: None, None
    size: dp(321), dp(53)
    color: 1, 1, 1, 1
    font_size: dp(19)
    bold: True
    halign: 'center'
    text_size: self.width - dp(16), None

    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.035
        RoundedRectangle:
            pos: self.x + dp(2), self.y - dp(5)
            size: self.size
            radius: [self.height / 2, ]
        Color:
            rgba: 0, 0, 0, 0.045
        RoundedRectangle:
            pos: self.x + dp(1), self.y - dp(3)
            size: self.size
            radius: [self.height / 2, ]
        Color:
            rgba: 0, 0, 0, 0.06
        RoundedRectangle:
            pos: self.x, self.y - dp(1.5)
            size: self.size
            radius: [self.height / 2, ]
        Color:
            # Цвет плавно темнеет при нажатии (press_tint: 0 -> 1),
            # а не переключается рывком, как в стандартной кнопке.
            rgba: 0.294 - 0.074 * self.press_tint, 0.184 - 0.064 * self.press_tint, 0.878 - 0.158 * self.press_tint, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2, ]

# --- SECONDARY КНОПКА (белая с обводкой 3px, чёрный текст) ----------------

<PillOutlineButton@Btn>:
    size_hint: None, None
    size: dp(218), dp(52.8)
    color: 0, 0, 0, 1
    font_size: dp(19)
    bold: True
    halign: 'center'
    text_size: self.width - dp(16), None

    canvas.before:
        Color:
            rgba: 1 - 0.03 * self.press_tint, 1 - 0.03 * self.press_tint, 1 - 0.02 * self.press_tint, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2, ]
        Color:
            rgba: 0.294, 0.184, 0.878, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.height / 2)
            width: dp(3)

# --- ПОЛЕ ВВОДА (скруглённая «таблетка» #EFEFF4) -------------------------

<PillInput@TextInput>:
    size_hint: None, None
    size: dp(300), dp(50)
    multiline: False
    write_tab: False
    padding: [dp(22), (self.height - self.line_height) / 2]
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: 0.08, 0.08, 0.1, 1
    hint_text_color: 0.557, 0.557, 0.576, 1
    cursor_color: 0.294, 0.184, 0.878, 1
    font_size: dp(19.5)

    # Фон в canvas.before (canvas периодически чистится через canvas.clear()).
    # ВНИМАНИЕ: style.kv держит Color текста и курсора тоже в canvas.before, а наши
    # инструкции добавляются ПОСЛЕ них — color state на входе в главный canvas
    # становится цветом пилюли, и хинт/курсор рисуются цветом фона. Поэтому после
    # пилюли продублированы Color курсора и Color текста (как в style.kv).
    canvas.before:
        Color:
            rgba: 0.937, 0.937, 0.957, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2, ]
        Color:
            rgba:
                (self.cursor_color
                if self.focus and not self._cursor_blink
                and int(self.x + self.padding[0]) <= self._cursor_visual_pos[0] <= int(self.x + self.width - self.padding[2])
                else (0, 0, 0, 0))
        Rectangle:
            pos: self._cursor_visual_pos
            size: self.cursor_width, -self._cursor_visual_height
        Color:
            rgba: self.disabled_foreground_color if self.disabled else (self.hint_text_color if not self.text else self.foreground_color)

# --- ПРОГРЕСС (трек 295x5 #C8C8C8, заливка #4B2FE0) ----------------------

<RegProgress@Widget>:
    size_hint: None, None
    size: dp(295), dp(5)
    value: 0

    canvas:
        Color:
            rgba: 0.784, 0.784, 0.784, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(2.5), ]
        Color:
            rgba: 0.294, 0.184, 0.878, 1
        RoundedRectangle:
            pos: self.pos
            size: min(self.value, self.width), self.height
            radius: [dp(2.5), ]

# --- СТРОКА-ПЕРЕКЛЮЧАТЕЛЬ (галочка + подпись) -------------------------------
# Для форм, где пункты идут списком. CheckToggle ниже рассчитан на макет,
# где он стоит рядом с текстом абсолютными координатами; здесь нужна
# строка, которая сама занимает место в списке.

<CheckRow@BoxLayout>:
    text: ''
    size_hint_y: None
    height: dp(44)
    spacing: dp(12)

    CheckToggle:
        id: box
        size_hint: None, None
        size: dp(28), dp(28)
        pos_hint: {'center_y': 0.5}

    Label:
        text: root.text
        font_size: dp(17)
        color: 0, 0, 0, 1
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None

# --- ЧЕКБОКС «Запомнить меня» (28x28 rx9, галочка спрайт rh_check) -------

<CheckToggle@PressToggle>:
    size_hint: None, None
    size: dp(28), dp(28)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    border: 0, 0, 0, 0

    canvas:
        # Заливка: включённая — фиолетовая, выключенная — белая. Раньше
        # заливка была белой всегда, и у включённой галочки фон и сама
        # галочка были одного цвета: галочка пропадала.
        Color:
            rgba: 0.294, 0.184, 0.878, 1 if self.state == 'down' else 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(9), ]
        Color:
            rgba: 0.294, 0.184, 0.878, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(9))
            width: dp(2)
        Color:
            rgba: 1, 1, 1, 1 if self.state == 'down' else 0
        Rectangle:
            pos: self.x + dp(4), self.y + dp(5.5)
            size: dp(21), dp(17)
            source: app.sprite('rh_check')