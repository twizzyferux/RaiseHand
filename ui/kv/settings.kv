# Настройки: ник, статус, аватар, смена пароля (старый не нужен).
# Стиль — pill-поля и FormButton, как на шагах регистрации.

<SettingsScreen>:
    nickname_field: nickname_field
    status_field: status_field
    password_field: password_field
    password_repeat_field: password_repeat_field

    FormScroll:
        Box:
            size_hint_y: None
            height: self.minimum_height

            TitleLabel:
                text: 'Настройки'

            BodyLabel:
                text: 'Интерфейс'
                bold: True
                color: 0, 0, 0, 1
                font_size: dp(16)

            # Галочка как системная «Меньше прозрачности»:
            # стекло становится плотнее и почти не просвечивает.
            CheckRow:
                id: solid_glass
                text: 'Меньше прозрачности'

            BodyLabel:
                text: 'Профиль'
                bold: True
                color: 0, 0, 0, 1
                font_size: dp(16)

            Field:
                id: nickname_field
                hint_text: 'Ник (виден всем в чате)'

            Field:
                id: status_field
                hint_text: 'Статус (например: 9А класс)'

            FormOutlineButton:
                text: 'Выбрать аватар'
                on_release: root.choose_avatar()

            BodyLabel:
                text: root.avatar_hint
                color: 0.4, 0.4, 0.42, 1

            FormButton:
                text: 'Сохранить профиль'
                on_release: root.save_profile()

            BodyLabel:
                text: 'Смена пароля'
                bold: True
                color: 0, 0, 0, 1
                font_size: dp(16)

            PasswordField:
                id: password_field
                hint_text: 'Новый пароль'
                password: True

            PasswordField:
                id: password_repeat_field
                hint_text: 'Повторите новый пароль'
                password: True

            FormButton:
                text: 'Сменить пароль'
                on_release: root.save_password()

            BodyLabel:
                text: 'Приложение'
                bold: True
                color: 0, 0, 0, 1
                font_size: dp(16)

            FormOutlineButton:
                text: 'Логи приложения'
                on_release: app.go('logs')

            LinkButton:
                text: 'Назад'
                on_release: app.go('home')

            LinkButton:
                text: 'Выйти'
                color: 0.75, 0.2, 0.2, 1
                on_release: root.do_logout()
