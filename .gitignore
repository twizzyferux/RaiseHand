# Виртуальные окружения и кэш — не в репозиторий
.venv/
.venv*/
__pycache__/
*.pyc
*.pyo

# Данные конкретного запуска: база, сессия, лог, загруженные файлы.
# В репозитории нужна только структура, поэтому оставляем папку,
# но её содержимое скрываем (чтобы случайно не утекли пароли/переписка).
data/*
!data/.gitkeep
outbox.log

# Скриншоты и временные проверки
_shots/
*.log

# Скрипты прогонов и разборки — только для работы на ПК
_probe.py
_dump_patterns.py
_extract_defs.py
_inv.py
_match.py
_layout.json

# Дизайн-макеты и исходники кита: они большие и нужны только на ПК,
# в сборку телефона не попадают (см. source.exclude_patterns)
проект/
*.spec
*.md

# Инструменты и мусор
tools/
_punch.ps1
_geometry.py
_parse_svg.py

# IDE
.idea/
.vscode/
*.swp
.DS_Store
