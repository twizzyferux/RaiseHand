# Виртуальные окружения и кэш — не в репозиторий
.venv/
.venv*/
__pycache__/
*.pyc
*.pyo

# Данные конкретного запуска: база, сессия, лог, загруженные файлы.
# В репозитории нужна только структура, поэтому оставляем папку,
# но её содержимое скрываем (чтобы случайно не утекли пароли/переписка).
data/*
!data/.gitkeep
outbox.log

# Скриншоты и временные проверки
_shots/
*.log

# Скрипты прогонов и разборки — только для работы на ПК
_probe.py
_dump_patterns.py
_extract_defs.py
_inv.py
_match.py
_layout.json

# Дизайн-макеты и исходники кита: они большие и нужны только на ПК,
# в сборку телефона не попадают (см. source.exclude_patterns)
проект/
*.spec
*.md

# Скиллы OpenCode — наоборот, в репозитории: без исключения выше они
# попали бы под *.md и не сохранились. Внутренние заметки (.opencode
# кроме skills) по-прежнему игнорируются.
# Скиллы OpenCode: свой скилл проекта в репозитории, скачанные — нет.
!.opencode/skills/
!.opencode/skills/**
.opencode/skills/*
!.opencode/skills/README.md
!.opencode/skills/glass-panel/
!.opencode/skills/glass-panel/**

# Шрифты: в сборку телефона идут только два используемых файла, а не
# весь набор (28 файлов, 9 МБ). Остальное приложение не читает.
assets/fonts/*
!assets/fonts/SF-Pro-Text-Regular.otf
!assets/fonts/SF-Pro-Text-Semibold.otf

# Инструменты и мусор
tools/
_punch.ps1
_geometry.py
_parse_svg.py

# IDE
.idea/
.vscode/
*.swp
.DS_Store
